generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  VET
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ClinicStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ClinicMemberRole {
  ADMIN
  VET
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             UserRole       @default(OWNER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  pets             Pet[]
  appointments     Appointment[]  @relation("OwnerAppointments")
  clinicMembership ClinicMember?
  vetRecords       MedicalRecord[] @relation("VetRecords")
}

model Clinic {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  addressLine1 String
  city         String
  postcode     String
  phone        String?
  email        String?
  services     String         @default("")
  emergency24h Boolean        @default(false)
  status       ClinicStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  members      ClinicMember[]
  appointments Appointment[]
  records      MedicalRecord[]
}

model ClinicMember {
  id        String           @id @default(cuid())
  clinicId  String
  userId    String           @unique
  role      ClinicMemberRole @default(VET)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
}

model Pet {
  id           String          @id @default(cuid())
  ownerId      String
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  species      String
  breed        String?
  dateOfBirth  DateTime?
  sex          String?
  weightKg     Float?
  microchipId  String?         @unique
  allergies    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  records      MedicalRecord[]
}

model Appointment {
  id          String            @id @default(cuid())
  petId       String
  ownerId     String
  clinicId    String?
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner       User              @relation("OwnerAppointments", fields: [ownerId], references: [id], onDelete: Cascade)
  clinic      Clinic?           @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  clinicName  String
  vetName     String?
  startsAt    DateTime
  reason      String?
  status      AppointmentStatus @default(PENDING)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model MedicalRecord {
  id          String   @id @default(cuid())
  petId       String
  clinicId    String?
  vetId       String?
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic      Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  vet         User?    @relation("VetRecords", fields: [vetId], references: [id], onDelete: SetNull)
  recordType  String
  title       String
  description String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}
